# Template for the config overlay. The REAL file lives ONLY on the box, at
#
#   /etc/config/nuzur/donald/prod.yaml     (root-owned, chmod 600)
#
# which the charts mount as a hostPath at /root/hostconfig, so the pod sees it at
# /root/hostconfig/nuzur/donald/prod.yaml. It is generated by
# scripts/03-deploy.sh from /etc/donald/credentials.env. Never commit the real one.
#
# Why the overlay is mandatory: config/base.yaml inside the image ships with
# literal `<< Database Name Here>>` placeholders for every db field. The loader
# reads CONFIG=/root/config,/root/hostconfig/nuzur/donald — base.yaml from the
# first, prod.yaml from the second — and later wins.

db:
  - name: donald
    host: donald-mysql.donald.svc.cluster.local
    port: "3306"
    user: donald
    pswd: "REPLACE_ME"
    # parseTime=true is NOT optional: every entity has created_at/updated_at and
    # go-sql-driver cannot scan DATETIME without it, so essentially every read
    # fails at runtime rather than at startup.
    # interpolateParams=true avoids a PREPARE/EXECUTE/CLOSE round trip per list
    # query (recommended by the generated base.yaml comments).
    params: "parseTime=true&interpolateParams=true&charset=utf8mb4"
    driver: "mysql"

# Cloudflare R2, not AWS: region `auto` plus the account endpoint.
# Leave key_id/secret empty and artifact uploads degrade gracefully — storage
# logs a warning at startup and /upload and /sign answer 503. Everything else
# (CRUD, the MCP tools, the SSE stream) works.
aws:
  region: auto
  key_id: ""
  secret: ""
  bucket: nextwave-donald
  endpoint: "https://422d3de7d35153929e0564d10734ad7b.r2.cloudflarestorage.com"

monitoring:
  enabled: false
